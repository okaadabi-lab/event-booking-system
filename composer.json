{
    "name": "oka-samdya-adabi/event-booking-system",
    "description": "Booking and operations system for an event decoration & venue rental business.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Oka Samdya Adabi"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": [
            "phpcs",
            "phpstan analyse --memory-limit=512M"
        ],
        "migrate": "php bin/migrate",
        "seed": "php bin/seed",
        "serve": "php -S 127.0.0.1:8081 -t public"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
