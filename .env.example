APP_NAME="Lentera Decor & Hall"
# development | production
APP_ENV=development
# Show exception details in error pages. Always false in production.
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=event_booking
DB_USERNAME=root
DB_PASSWORD=
# Used only by the test suite. Must end in "_test"; tests truncate its tables.
DB_TEST_DATABASE=event_booking_test

# auto = Secure flag when the request arrives over HTTPS; true/false to force.
SESSION_SECURE_COOKIE=auto

LOG_PATH=storage/logs/app.log
LOG_LEVEL=info

# Business rules
DEPOSIT_PERCENT=30
BALANCE_DUE_DAYS_BEFORE_EVENT=14
RESOURCE_BUFFER_MINUTES=120

# Abuse limits
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
INQUIRY_MAX_PER_HOUR=5
