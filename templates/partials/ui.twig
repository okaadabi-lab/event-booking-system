{% macro lantern(size) %}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path d="M16 2v3" stroke="#f2b33d" stroke-width="2" stroke-linecap="round"/>
  <path d="M10 7h12l-1 3H11z" fill="#f2b33d"/>
  <path d="M11 10h10c2 3 3 6 3 8.5S23 25 21 27H11c-2-2-3-5.5-3-8.5S9 13 11 10z" fill="#f2b33d" opacity=".25"/>
  <path d="M11 10h10c2 3 3 6 3 8.5S23 25 21 27H11c-2-2-3-5.5-3-8.5S9 13 11 10z" fill="none" stroke="#f2b33d" stroke-width="1.6"/>
  <path d="M16 13c1.6 2 2.4 3.6 2.4 5a2.4 2.4 0 0 1-4.8 0c0-1.4.8-3 2.4-5z" fill="#f2b33d"/>
  <path d="M12 27h8v2h-8z" fill="#f2b33d"/>
</svg>
{% endmacro %}

{% macro icon(name) %}
<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
{% if name == 'venue' %}<path d="M2 14V6l6-4 6 4v8M6 14V9h4v5"/>
{% elseif name == 'crew' %}<circle cx="5.5" cy="5" r="2"/><circle cx="11" cy="5.5" r="1.6"/><path d="M1.8 13c.4-2.5 1.8-3.8 3.7-3.8S8.8 10.5 9.2 13M9.6 9.6c1.9-.4 3.9.5 4.5 3.4"/>
{% elseif name == 'clock' %}<circle cx="8" cy="8" r="6"/><path d="M8 4.5V8l2.5 1.5"/>
{% elseif name == 'pin' %}<path d="M8 14s-4.5-4.2-4.5-7.5a4.5 4.5 0 0 1 9 0C12.5 9.8 8 14 8 14z"/><circle cx="8" cy="6.5" r="1.5"/>
{% elseif name == 'guests' %}<circle cx="8" cy="5" r="2.5"/><path d="M3 14c.5-3 2.4-4.5 5-4.5s4.5 1.5 5 4.5"/>
{% endif %}
</svg>
{% endmacro %}

{% macro status(status) %}
<span class="status status--{{ status.value ?? status }}">{{ (status.value ?? status)|capitalize }}</span>
{% endmacro %}

{% macro field_error(errors, name) %}
{% if errors[name] is defined %}<p class="field__error" id="{{ name }}-error">{{ errors[name] }}</p>{% endif %}
{% endmacro %}

{% macro invalid(errors, name) %}{% if errors[name] is defined %} aria-invalid="true" aria-describedby="{{ name }}-error"{% endif %}{% endmacro %}

{% macro csrf(token) %}<input type="hidden" name="_csrf" value="{{ token }}">{% endmacro %}

{% macro progress(percent, cls) %}
<svg class="{{ cls }}" viewBox="0 0 100 4" preserveAspectRatio="none" role="img" aria-label="{{ percent }}% paid"><rect width="100" height="4" rx="2"/><rect width="{{ percent }}" height="4" rx="2"/></svg>
{% endmacro %}
