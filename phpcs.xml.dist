<?xml version="1.0"?>
<ruleset name="event-booking-system">
    <description>PSR-12 for application code, tests and CLI scripts.</description>
    <file>src</file>
    <file>config</file>
    <file>tests</file>
    <file>public/index.php</file>
    <file>bin/migrate</file>
    <file>bin/seed</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <!-- PSR-12 calls 120 a soft limit; SQL strings and match arms read better slightly longer. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="140"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
